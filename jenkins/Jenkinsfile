pipeline {
  agent any

  environment {
    AWS_REGION  = 'eu-west-1'
    ENVIRONMENT = 'dev'
    TF_DIR      = 'infra/terraform'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Static checks') {
      steps {
        sh 'python -m pip install --quiet ruff || true'
        sh 'ruff check app tests || true'
      }
    }

    stage('Unit tests') {
      steps {
        sh 'python -m pip install --quiet pytest'
        sh 'python -m pytest -q'
      }
    }

    stage('Terraform init') {
      steps {
        dir("${TF_DIR}") {
          sh 'terraform init -input=false'
        }
      }
    }

    stage('Terraform plan') {
      steps {
        dir("${TF_DIR}") {
          sh 'terraform plan -input=false -var-file=environments/dev.tfvars -out=tfplan'
        }
      }
    }

    stage('Terraform apply (dev)') {
      steps {
        dir("${TF_DIR}") {
          sh 'terraform apply -input=false -auto-approve tfplan'
        }
      }
    }

    stage('Deploy Lambda package') {
      steps {
        // Lambda code is packaged and deployed by the terraform apply above
        // (archive_file + aws_lambda_function). This stage is a hook for any
        // additional artifact publishing.
        echo 'Lambda package deployed via Terraform.'
      }
    }

    stage('Post-deployment tests') {
      steps {
        dir("${TF_DIR}") {
          sh 'terraform output -raw healthcheck_endpoint > ../../.endpoint'
        }
        sh 'HEALTHCHECK_ENDPOINT=$(cat .endpoint) python -m pytest -q tests/test_healthcheck_endpoint.py'
      }
    }

    stage('Publish results') {
      steps {
        junit allowEmptyResults: true, testResults: 'reports/*.xml'
        echo 'SCRUM-1 health-check deployed and validated.'
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
