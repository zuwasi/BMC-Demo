pipeline {
  agent any

  environment {
    AWS_REGION            = 'eu-west-1'
    AWS_DEFAULT_REGION    = 'eu-west-1'
    ENVIRONMENT           = 'dev'
    TF_DIR                = 'infra/terraform'
    AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
    AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    PATH                  = "C:\\Program Files\\Amazon\\AWSCLIV2;${env.PATH}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Verify tooling') {
      steps {
        bat 'python --version'
        bat 'terraform version'
        bat 'aws --version'
        bat 'aws sts get-caller-identity'
      }
    }

    stage('Unit tests') {
      steps {
        bat 'python -m pip install --quiet --disable-pip-version-check pytest'
        bat 'python -m pytest -q'
      }
    }

    stage('Terraform init') {
      steps {
        dir("${TF_DIR}") {
          bat 'terraform init -input=false'
        }
      }
    }

    stage('Terraform plan') {
      steps {
        dir("${TF_DIR}") {
          bat 'terraform plan -input=false -var-file=environments/dev.tfvars -out=tfplan'
        }
      }
    }

    stage('Terraform apply (dev)') {
      steps {
        dir("${TF_DIR}") {
          bat 'terraform apply -input=false -auto-approve tfplan'
        }
      }
    }

    stage('Deploy Lambda package') {
      steps {
        // Lambda code is packaged (archive_file) and deployed by the
        // terraform apply above. Hook kept for extra artifact publishing.
        echo 'Lambda package deployed via Terraform.'
      }
    }

    stage('Post-deployment tests') {
      steps {
        dir("${TF_DIR}") {
          bat 'terraform output -raw healthcheck_endpoint > endpoint.txt'
        }
        powershell '''
          $ep = (Get-Content "$env:TF_DIR\\endpoint.txt").Trim()
          Write-Host "Deployed endpoint: $ep"
          $env:HEALTHCHECK_ENDPOINT = $ep
          python -m pytest -q tests/test_healthcheck_endpoint.py
        '''
      }
    }

    stage('Publish results') {
      steps {
        echo 'SCRUM-1 health-check deployed and validated.'
      }
    }
  }
}
